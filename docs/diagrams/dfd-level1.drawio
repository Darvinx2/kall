<mxfile host="app.diagrams.net">
  <diagram name="DFD Level 1" id="dfd-l1">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="DFD Level 1 — потоки данных лабораторной работы №1, нотация Йордана — Коуда" style="text;html=1;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- ВНЕШНЯЯ СУЩНОСТЬ -->
        <mxCell id="user" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;аналитик кафедры" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ПРОЦЕССЫ GATEWAY (зелёные) -->
        <mxCell id="p1" value="&lt;b&gt;1.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;Аутентификация&lt;br&gt;(JWT, gateway)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;Валидация и&lt;br&gt;маршрутизация&lt;br&gt;запроса" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;6.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;Возврат ответа&lt;br&gt;клиенту" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="360" width="150" height="110" as="geometry" />
        </mxCell>

        <!-- ПРОЦЕСС-ЛАБА (фиолетовый) -->
        <mxCell id="p3" value="&lt;b&gt;3.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;ЛР1: студенты с минимальным&lt;br&gt;процентом посещения&lt;br&gt;лекций по термину&lt;br&gt;за период" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="650" y="210" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- ХРАНИЛИЩА (жёлтые открытые) — четыре, что использует ЛР1 -->
        <mxCell id="d1" value="&lt;b&gt;D1&lt;/b&gt;  Elasticsearch — полнотекст по лекциям" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="90" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;D2&lt;/b&gt;  Neo4j — связи студент—курс" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="230" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;D3&lt;/b&gt;  PostgreSQL — schedule, attendance" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="370" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;D4&lt;/b&gt;  Redis — карточки по номеру зачётки" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="510" width="340" height="55" as="geometry" />
        </mxCell>

        <!-- ПОТОКИ: пользователь ↔ gateway -->
        <mxCell id="e1" value="логин/пароль" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="JWT-токен" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.15;entryY=0;" edge="1" parent="1" source="p1" target="user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="запрос отчёта + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="JSON-отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p6" target="user"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- gateway → лаба → возврат -->
        <mxCell id="e5" value="term, период, limit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="готовый отчёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="p3" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ЛР1 (3.0) ↔ хранилища, по шагам -->
        <mxCell id="l1d1" value="1. термин ⇄ id лекций и курсов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=open;endArrow=open;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l1d2" value="2. курсы ⇄ пары студент-курс" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=open;endArrow=open;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l1d3" value="3. пары ⇄ план/факт посещения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=open;endArrow=open;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l1d4" value="4. id студентов ⇄ карточки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=open;endArrow=open;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l1d4b" value="откат: карточка при промахе" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;startArrow=none;endArrow=open;exitX=0.85;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="lg" value="Обозначения (Йордан — Коуд):   ◯ процесс (круг с номером)      ▭ внешняя сущность      ⊏⊐ хранилище данных (открытый прямоугольник)      → поток данных.    Зелёные процессы — gateway, фиолетовый — сервис ЛР1.    Пунктир — резервный поток (откат в PostgreSQL при промахе витрины Redis)." style="text;html=1;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1390" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
